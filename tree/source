-- [[ SMOOTH FADE LOGIC ]] --
-- This handles the transition when opening/closing the menu
function Luminaia:SetToggled(state)
    self.Toggled = state
    local targetTrans = state and 0.85 or 0
    local targetTextTrans = state and 1 or 0
    
    -- Animate Blur
    if Lighting:FindFirstChild("LuminaiaBlur") then
        TS:Create(Lighting.LuminaiaBlur, TweenInfo.new(0.3), {Size = state and 20 or 0}):Play()
        Lighting.LuminaiaBlur.Enabled = true -- Keep enabled for the transition
    end

    -- Animate Windows and Elements
    task.spawn(function()
        for i = 1, 10 do
            local alpha = state and (i / 10) or (1 - (i / 10))
            for _, win in pairs(self.Windows) do
                -- Fade Pillar
                win.Drawings.Main.Transparency = alpha * 0.85
                win.Drawings.Outline.Transparency = alpha * 0.4
                win.Drawings.Header.Transparency = alpha
                win.Drawings.Line.Transparency = alpha
                win.Drawings.Title.Transparency = alpha
                
                -- Fade Elements
                for _, element in pairs(win.Elements) do
                    for _, drawing in pairs(element.Drawings) do
                        drawing.Transparency = alpha
                    end
                    -- If a dropdown is open, fade its options too
                    if element.OptionDrawings then
                        for _, optDraw in pairs(element.OptionDrawings) do
                            optDraw.Transparency = alpha
                        end
                    end
                end
            end
            RS.RenderStepped:Wait()
        end
        
        -- Final visibility lock
        if not state then
            for _, win in pairs(self.Windows) do win:SetVisible(false) end
            if Lighting:FindFirstChild("LuminaiaBlur") then Lighting.LuminaiaBlur.Enabled = false end
        else
            for _, win in pairs(self.Windows) do win:SetVisible(true) end
        end
    end)
end

