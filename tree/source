local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- [[ DRAWING API WRAPPER ]] --
local function Draw(type, props)
    local obj = Drawing.new(type)
    for i, v in pairs(props) do
        obj[i] = v
    end
    return obj
end

-- [[ BLUR SYSTEM ]] --
local Blur = Lighting:FindFirstChild("LuminaiaBlur") or Instance.new("BlurEffect")
Blur.Name = "LuminaiaBlur"
Blur.Size = 20
Blur.Enabled = true
Blur.Parent = Lighting

-- [[ WATERMARK SYSTEM ]] --
local Watermark = Draw("Text", {
    Text = "LUMINAIA",
    Size = 28,
    Position = Vector2.new(25, 25),
    Visible = true,
    Outline = true,
    ZIndex = 100
})

local WatermarkGlow = Draw("Text", {
    Text = "LUMINAIA",
