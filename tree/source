-- [[ COLOR PICKER COMPONENT ]] --
function Window:AddColorPicker(text, default, flag, callback)
    local Picker = {
        Color = default or Color3.fromRGB(255, 255, 255),
        Open = false,
        Drawings = {},
        PickerDrawings = {}
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 8

    local Label = Draw("Text", {
        Text = text,
        Size = 12,
        Color = Color3.fromRGB(200, 200, 200),
        Position = Vector2.new(XPos, YPos),
        Visible = true,
        Outline = true,
        ZIndex = 6
    })

    -- The small preview box on the right
    local Preview = Draw("Square", {
        Size = Vector2.new(16, 10),
        Position = Vector2.new(XPos + 58, YPos + 2),
        Color = Picker.Color,
        Filled = true,
        Visible = true,
        Thickness = 1,
        ZIndex = 7
    })

    Picker.Drawings = {Label, Preview}

    -- [[ PICKER MENU LOGIC ]] --
    function Picker:Toggle()
        self.Open = not self.Open
        for _, v in pairs(self.PickerDrawings) do v:Remove() end
        self.PickerDrawings = {}

        if self.Open then
            Window:ManageSpace(self) -- Close other dropdowns/pickers

            -- A simple 3x3 grid of preset colors to fit the 90px width
            local Colors = {
                Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 255),
                Color3.fromRGB(255, 255, 0), Color3.fromRGB(255, 0, 255), Color3.fromRGB(0, 255, 255),
                Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 150), Color3.fromRGB(50, 50, 50)
            }

            local GridBG = Draw("Square", {
                Size = Vector2.new(74, 74),
                Position = Preview.Position + Vector2.new(-58, 15),
                Color = Color3.fromRGB(20, 20, 20),
                Filled = true,
                Visible = true,
                ZIndex = 15
            })
            table.insert(self.PickerDrawings, GridBG)

            for i, col in pairs(Colors) do
                local r = math.floor((i-1) / 3)
                local c = (i-1) % 3
                
                local ColBtn = Draw("Square", {
                    Size = Vector2.new(20, 20),
                    Position = GridBG.Position + Vector2.new(4 + (c * 23), 4 + (r * 23)),
                    Color = col,
                    Filled = true,
                    Visible = true,
                    ZIndex = 16
                })
                table.insert(self.PickerDrawings, ColBtn)
            end
        end
    end

    function Picker:Close()
        self.Open = false
        for _, v in pairs(self.PickerDrawings) do v.Visible = false end
    end

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            -- Click Preview to Open
            if MouseOver(Preview.Position, Preview.Size) or MouseOver(Label.Position, Vector2.new(50, 12)) then
                Picker:Toggle()
            end

            -- Click Grid to Select
            if Picker.Open then
                local Colors = {
                    Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 0, 255),
                    Color3.fromRGB(255, 255, 0), Color3.fromRGB(255, 0, 255), Color3.fromRGB(0, 255, 255),
                    Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 150, 150), Color3.fromRGB(50, 50, 50)
                }
                local GridStart = Preview.Position + Vector2.new(-58, 15)
                
                for i, col in pairs(Colors) do
                    local r = math.floor((i-1) / 3)
                    local c = (i-1) % 3
                    local BtnPos = GridStart + Vector2.new(4 + (c * 23), 4 + (r * 23))
                    
                    if MouseOver(BtnPos, Vector2.new(20, 20)) then
                        Picker.Color = col
                        Preview.Color = col
                        Luminaia.Accent = col -- Global Accent Change!
                        Luminaia.Flags[flag] = col
                        callback(col)
                        Picker:Toggle()
                    end
                end
            end
        end
    end)

    self.YOffset = self.YOffset + 20
    table.insert(self.Elements, Picker)
    return Picker
end

