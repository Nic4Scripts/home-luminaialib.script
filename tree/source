local HttpService = game:GetService("HttpService")

-- [[ CONFIG DIRECTORY SETUP ]] --
if not isfolder("Luminaia_Configs") then
    makefolder("Luminaia_Configs")
end

-- [[ SAVE LOGIC ]] --
function Luminaia:SaveConfig(name)
    local Data = {}
    for flag, value in pairs(self.Flags) do
        -- Convert Color3 to Table for JSON compatibility
        if typeof(value) == "Color3" then
            Data[flag] = {value.r, value.g, value.b}
        elseif typeof(value) == "EnumItem" then
            Data[flag] = tostring(value)
        else
            Data[flag] = value
        end
    end
    
    local JSON = HttpService:JSONEncode(Data)
    writefile("Luminaia_Configs/" .. name .. ".json", JSON)
    self:Notify("Config '" .. name .. "' Saved!")
end

-- [[ LOAD LOGIC ]] --
function Luminaia:LoadConfig(name)
    local Path = "Luminaia_Configs/" .. name .. ".json"
    if not isfile(Path) then 
        self:Notify("Config not found!") 
        return 
    end
    
    local Raw = readfile(Path)
    local Data = HttpService:JSONDecode(Raw)
    
    for flag, value in pairs(Data) do
        -- Logic to apply loaded values back to UI elements
        self.Flags[flag] = value
        -- Note: Real-time UI updating for loaded configs 
        -- will be finalized in the Phase 9 "Registry Refresh".
    end
    
    self:Notify("Config '" .. name .. "' Loaded!")
end

