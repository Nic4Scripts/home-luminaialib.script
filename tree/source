-- [[ DYNAMIC TEXT WRAPPER ]] --
-- Ensures names don't bleed out of the 90px width
local function ClampText(textObj, maxWidth)
    local rawText = textObj.Text
    while textObj.TextBounds.X > maxWidth and #textObj.Text > 3 do
        textObj.Text = string.sub(textObj.Text, 1, #textObj.Text - 1)
    end
    if textObj.Text ~= rawText then
        textObj.Text = textObj.Text .. ".."
    end
end

