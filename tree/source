-- [[ WINDOW CLASS ]] --
function Luminaia:CreateWindow(name)
    local Window = {
        Title = name,
        Elements = {},
        Active = true,
        Visible = true,
        YOffset = 35, -- Start drawing elements below header
        CurrentDropdown = nil
    }

    local Screen = workspace.CurrentCamera.ViewportSize
    local Index = #self.Windows -- Which window is this? (0-11)
    
    -- [[ 12-PILLAR MATH: 6 PER ROW ]] --
    local Col = Index % 6
    local Row = math.floor(Index / 6)
    
    -- 90px width + 15px padding = 105px per slot
    local SpacingX = 105 
    local TotalWidth = (6 * 90) + (5 * 15)
    
    -- Start position for the grid
    local StartX = (Screen.X / 2) - (TotalWidth / 2) + (Col * SpacingX)
    local StartY = (Screen.Y / 2) - (Row == 0 and 510 or -10) -- Centered vertically

    -- [[ THE 1000PX PILLAR ]] --
    local MainFrame = Draw("Square", {
        Size = Vector2.new(90, 1000),
        Position = Vector2.new(StartX, StartY),
        Color = Color3.fromRGB(12, 12, 12),
        Filled = true,
        Visible = true,
        Transparency = 0.85,
        ZIndex = 1
    })

    local MainOutline = Draw("Square", {
        Size = Vector2.new(90, 1000),
        Position = MainFrame.Position,
        Color = Color3.fromRGB(40, 40, 40),
        Filled = false,
        Visible = true,
        Thickness = 1,
        Transparency = 0.4,
        ZIndex = 2
    })

    -- [[ THE HEADER ]] --
    local Header = Draw("Square", {
        Size = Vector2.new(90, 25),
        Position = MainFrame.Position,
        Color = Color3.fromRGB(22, 22, 22),
        Filled = true,
        Visible = true,
        ZIndex = 3
    })

    local HeaderLine = Draw("Square", {
        Size = Vector2.new(90, 2),
        Position = Header.Position + Vector2.new(0, 23),
        Color = self.Accent,
        Filled = true,
        Visible = true,
        ZIndex = 4
    })

    local TitleText = Draw("Text", {
        Text = name:upper(),
        Size = 13,
        Center = true,
        Position = Header.Position + Vector2.new(45, 6),
        Visible = true,
        Color = Color3.new(1, 1, 1),
        Outline = true,
        ZIndex = 5
    })

    -- Store drawing objects for visibility toggling
    Window.Drawings = {
        Main = MainFrame,
        Outline = MainOutline,
        Header = Header,
        Line = HeaderLine,
        Title = TitleText
    }

    -- [[ VISIBILITY HANDLER ]] --
    function Window:SetVisible(state)
        self.Visible = state
        for _, drawObj in pairs(self.Drawings) do
            drawObj.Visible = state
        end
        -- Toggle all elements within this window
        for _, element in pairs(self.Elements) do
            for _, edraw in pairs(element.Drawings) do
                edraw.Visible = state
            end
        end
    end

    -- [[ CLEANUP/SPACE HANDLER ]] --
    -- Ensures only one dropdown/tab is open per pillar to keep it CLEAN
    function Window:ManageSpace(newElement)
        if self.CurrentDropdown and self.CurrentDropdown ~= newElement then
            self.CurrentDropdown:Close()
        end
        self.CurrentDropdown = newElement
    end

    -- [[ ADD TO REGISTRY ]] --
    table.insert(self.Windows, Window)
    return Window
end

