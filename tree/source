-- [[ UTILS: MOUSE CHECK ]] --
local function MouseOver(pos, size)
    local MousePos = UIS:GetMouseLocation()
    return MousePos.X >= pos.X and MousePos.X <= pos.X + size.X and MousePos.Y >= pos.Y and MousePos.Y <= pos.Y + size.Y
end

-- [[ TOGGLE COMPONENT ]] --
function Window:AddToggle(text, flag, default, callback)
    local Toggle = {
        State = default or false,
        Drawings = {}
    }
    
    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X
    
    -- Toggle Background
    local ToggleText = Draw("Text", {
        Text = text,
        Size = 13,
        Color = Color3.fromRGB(200, 200, 200),
        Position = Vector2.new(XPos + 8, YPos),
        Visible = true,
        Outline = true,
        ZIndex = 6
    })
    
    -- Status Indicator (Linoria Style [ON/OFF])
    local Status = Draw("Text", {
        Text = Toggle.State and "[+]" or "[-]",
        Size = 13,
        Color = Toggle.State and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 50, 50),
        Position = Vector2.new(XPos + 70, YPos),
        Visible = true,
        Outline = true,
        ZIndex = 6
    })

    Toggle.Drawings = {ToggleText, Status}
    
    -- Input Logic
    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if MouseOver(Vector2.new(XPos, YPos), Vector2.new(90, 15)) then
                Toggle.State = not Toggle.State
                Status.Text = Toggle.State and "[+]" or "[-]"
                Status.Color = Toggle.State and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 50, 50)
                
                Luminaia.Flags[flag] = Toggle.State
                callback(Toggle.State)
            end
        end
    end)

    self.YOffset = self.YOffset + 18
    table.insert(self.Elements, Toggle)
    return Toggle
end

-- [[ BUTTON COMPONENT ]] --
function Window:AddButton(text, callback)
    local Button = {Drawings = {}}
    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X
    
    local BtnFrame = Draw("Square", {
        Size = Vector2.new(80, 16),
        Position = Vector2.new(XPos + 5, YPos),
        Color = Color3.fromRGB(30, 30, 30),
        Filled = true,
        Visible = true,
        Thickness = 1,
        ZIndex = 6
    })
    
    local BtnText = Draw("Text", {
        Text = text,
        Size = 12,
        Center = true,
        Position = BtnFrame.Position + Vector2.new(40, 2),
        Visible = true,
        Color = Color3.new(1, 1, 1),
        Outline = true,
        ZIndex = 7
    })

    Button.Drawings = {BtnFrame, BtnText}

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if MouseOver(BtnFrame.Position, BtnFrame.Size) then
                -- Visual Feedback (Quick Flash)
                BtnFrame.Color = Color3.fromRGB(60, 60, 60)
                task.wait(0.1)
                BtnFrame.Color = Color3.fromRGB(30, 30, 30)
                callback()
            end
        end
    end)

    self.YOffset = self.YOffset + 22
    table.insert(self.Elements, Button)
    return Button
end

