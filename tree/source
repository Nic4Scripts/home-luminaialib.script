-- [[ SLIDER COMPONENT ]] --
function Window:AddSlider(text, min, max, default, flag, callback)
    local Slider = {
        Value = default or min,
        Min = min,
        Max = max,
        Dragging = false,
        Drawings = {}
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 8
    
    local Label = Draw("Text", {
        Text = text .. ": " .. tostring(Slider.Value),
        Size = 12,
        Color = Color3.new(1, 1, 1),
        Position = Vector2.new(XPos, YPos),
        Visible = true,
        Outline = true,
        ZIndex = 6
    })

    local SliderBG = Draw("Square", {
        Size = Vector2.new(74, 4),
        Position = Vector2.new(XPos, YPos + 15),
        Color = Color3.fromRGB(30, 30, 30),
        Filled = true,
        Visible = true,
        ZIndex = 6
    })

    local SliderFill = Draw("Square", {
        Size = Vector2.new(((Slider.Value - min) / (max - min)) * 74, 4),
        Position = SliderBG.Position,
        Color = Luminaia.Accent,
        Filled = true,
        Visible = true,
        ZIndex = 7
    })

    Slider.Drawings = {Label, SliderBG, SliderFill}

    -- SLIDER LOGIC
    local function UpdateSlider()
        local MouseLoc = UIS:GetMouseLocation()
        local Percent = math.clamp((MouseLoc.X - SliderBG.Position.X) / SliderBG.Size.X, 0, 1)
        local Value = math.floor(min + (max - min) * Percent)
        
        Slider.Value = Value
        SliderFill.Size = Vector2.new(Percent * 74, 4)
        Label.Text = text .. ": " .. tostring(Value)
        
        Luminaia.Flags[flag] = Value
        callback(Value)
    end

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if MouseOver(SliderBG.Position - Vector2.new(0, 5), SliderBG.Size + Vector2.new(0, 10)) then
                Slider.Dragging = true
                UpdateSlider()
            end
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Slider.Dragging = false
        end
    end)

    RS.RenderStepped:Connect(function()
        if Slider.Dragging and Luminaia.Toggled then
            UpdateSlider()
        end
    end)

    self.YOffset = self.YOffset + 32
    table.insert(self.Elements, Slider)
    return Slider
end

-- [[ KEYBIND COMPONENT ]] --
function Window:AddKeybind(text, default, flag, callback)
    local Bind = {
        Key = default or Enum.KeyCode.F,
        Binding = false,
        Drawings = {}
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 8

    local Label = Draw("Text", {
        Text = text,
        Size = 13,
        Color = Color3.fromRGB(200, 200, 200),
        Position = Vector2.new(XPos, YPos),
        Visible = true,
        Outline = true,
        ZIndex = 6
    })

    local BindText = Draw("Text", {
        Text = "[" .. Bind.Key.Name:upper() .. "]",
        Size = 13,
        Color = Luminaia.Accent,
        Position = Vector2.new(XPos + 55, YPos),
        Visible = true,
        Outline = true,
        ZIndex = 6
    })

    Bind.Drawings = {Label, BindText}

    UIS.InputBegan:Connect(function(input)
        if Bind.Binding then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                Bind.Key = input.KeyCode
                BindText.Text = "[" .. input.KeyCode.Name:upper() .. "]"
                Bind.Binding = false
                BindText.Color = Luminaia.Accent
                Luminaia.Flags[flag] = input.KeyCode
            end
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if MouseOver(Vector2.new(XPos, YPos), Vector2.new(80, 15)) then
                Bind.Binding = true
                BindText.Text = "[...]"
                BindText.Color = Color3.new(1, 1, 0)
            end
        elseif input.KeyCode == Bind.Key and not Bind.Binding then
            callback() -- Trigger bind
        end
    end)

    self.YOffset = self.YOffset + 18
    table.insert(self.Elements, Bind)
    return Bind
end

