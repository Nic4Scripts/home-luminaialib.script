-- [[ DROPDOWN COMPONENT ]] --
function Window:AddDropdown(text, options, default, flag, callback)
    local Dropdown = {
        Options = options,
        Selected = default or options[1],
        Open = false,
        Drawings = {},
        OptionDrawings = {},
        YSize = 0
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 8

    -- The Header of the Dropdown
    local Label = Draw("Text", {
        Text = text,
        Size = 12,
        Color = Color3.fromRGB(180, 180, 180),
        Position = Vector2.new(XPos, YPos),
        Visible = true,
        Outline = true,
        ZIndex = 6
    })

    local Box = Draw("Square", {
        Size = Vector2.new(74, 16),
        Position = Vector2.new(XPos, YPos + 15),
        Color = Color3.fromRGB(25, 25, 25),
        Filled = true,
        Visible = true,
        Thickness = 1,
        ZIndex = 6
    })

    local SelectedText = Draw("Text", {
        Text = Dropdown.Selected,
        Size = 12,
        Center = true,
        Position = Box.Position + Vector2.new(37, 2),
        Visible = true,
        Color = Luminaia.Accent,
        Outline = true,
        ZIndex = 7
    })

    Dropdown.Drawings = {Label, Box, SelectedText}

    -- [[ OPEN/CLOSE LOGIC ]] --
    function Dropdown:Toggle()
        self.Open = not self.Open
        
        -- Clean up existing option visuals
        for _, draw in pairs(self.OptionDrawings) do
            draw:Remove()
        end
        self.OptionDrawings = {}

        if self.Open then
            -- Tell the Window to close other active dropdowns
            Window:ManageSpace(self)
            
            for i, opt in pairs(self.Options) do
                local OptBox = Draw("Square", {
                    Size = Vector2.new(74, 16),
                    Position = Box.Position + Vector2.new(0, i * 16),
                    Color = Color3.fromRGB(20, 20, 20),
                    Filled = true,
                    Visible = true,
                    ZIndex = 10
                })
                
                local OptTxt = Draw("Text", {
                    Text = opt,
                    Size = 12,
                    Center = true,
                    Position = OptBox.Position + Vector2.new(37, 2),
                    Visible = true,
                    Color = (opt == self.Selected and Luminaia.Accent or Color3.new(1, 1, 1)),
                    Outline = true,
                    ZIndex = 11
                })
                
                table.insert(self.OptionDrawings, OptBox)
                table.insert(self.OptionDrawings, OptTxt)
            end
        end
    end

    function Dropdown:Close()
        if self.Open then
            self.Open = false
            for _, draw in pairs(self.OptionDrawings) do draw.Visible = false end
        end
    end

    -- Input Handler for Dropdown
    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            -- Clicking the Main Box
            if MouseOver(Box.Position, Box.Size) then
                Dropdown:Toggle()
            end
            
            -- Clicking Options
            if Dropdown.Open then
                for i, opt in pairs(Dropdown.Options) do
                    local OptPos = Box.Position + Vector2.new(0, i * 16)
                    if MouseOver(OptPos, Vector2.new(74, 16)) then
                        Dropdown.Selected = opt
                        SelectedText.Text = opt
                        Luminaia.Flags[flag] = opt
                        callback(opt)
                        Dropdown:Toggle() -- Close after select
                    end
                end
            end
        end
    end)

    self.YOffset = self.YOffset + 38
    table.insert(self.Elements, Dropdown)
    return Dropdown
end

