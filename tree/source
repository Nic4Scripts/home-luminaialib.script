})

-- [[ MASTER NOTIFICATION SYSTEM ]] --
function Luminaia:Notify(msg)
    task.spawn(function()
        local Screen = workspace.CurrentCamera.ViewportSize
        local Box = Draw("Square", {
            Size = Vector2.new(290, 70),
            Position = Vector2.new(Screen.X - 310, Screen.Y + 100),
            Color = Color3.fromRGB(8, 8, 8),
            Filled = true,
            Visible = true,
            Thickness = 1,
            Transparency = 1
        })
        
        local AccentBar = Draw("Square", {
            Size = Vector2.new(2, 70),
            Position = Box.Position,
            Color = self.Accent,
            Filled = true,
            Visible = true
        })

        local Title = Draw("Text", {
            Text = "LUMINAIA",
            Size = 18,
            Color = Color3.new(1, 1, 1),
            Position = Box.Position + Vector2.new(15, 10),
            Visible = true,
            Outline = true
        })

        local Content = Draw("Text", {
            Text = msg .. "\nmade by prizmm, @" .. self.User .. " daddy :3",
            Size = 14,
            Color = Color3.fromRGB(180, 180, 180),
            Position = Box.Position + Vector2.new(15, 32),
            Visible = true
        })

        -- Slide Up Animation
        local startTick = tick()
        local duration = 0.6
        local targetY = Screen.Y - 90
        
        while tick() - startTick < duration do
            local t = (tick() - startTick) / duration
            local ease = 1 - math.pow(1 - t, 4) -- Quantic Out
            local currentY = (Screen.Y + 100) - ((Screen.Y + 100 - targetY) * ease)
            
            Box.Position = Vector2.new(Box.Position.X, currentY)
            AccentBar.Position = Box.Position
            Title.Position = Box.Position + Vector2.new(15, 10)
            Content.Position = Box.Position + Vector2.new(15, 32)
            RS.RenderStepped:Wait()
        end

        task.wait(5)

        -- Fade Out
        for i = 1, 0, -0.05 do
            Box.Transparency = i
            AccentBar.Transparency = i
            Title.Transparency = i
            Content.Transparency = i
            task.wait(0.02)
        end
        
        Box:Remove() AccentBar:Remove() Title:Remove() Content:Remove()
    end)
end

-- [[ THE MASTER PULSE LOOP ]] --
RS.RenderStepped:Connect(function()
    local pulse = (math.sin(tick() * 4) + 1) / 2
    local color = Color3.new(pulse, pulse, pulse)
    
    Watermark.Color = color
    WatermarkGlow.Color = color
    WatermarkGlow.Transparency = 0.3 * pulse
    
    -- Handle Blur Toggle
    Blur.Enabled = Luminaia.Toggled
end)

-- [[ INPUT TOGGLE HANDLER ]] --
UIS.InputBegan:Connect(function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift then
        Luminaia.Toggled = not Luminaia.Toggled
        for _, win in pairs(Luminaia.Windows) do
            win:SetVisible(Luminaia.Toggled)
        end
    end
end)

