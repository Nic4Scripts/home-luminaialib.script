-- [[ SMOOTH TRANSITION ENGINE ]] --
-- This handles the fading of all 12 pillars simultaneously
function Luminaia:AnimateToggle(state)
    local TargetTransparency = state and 0.9 or 0
    local TargetTextAlpha = state and 1 or 0
    local Speed = 0.15 -- Fast but buttery smooth

    task.spawn(function()
        for i = 1, 10 do
            local Alpha = state and (i / 10) or (1 - (i / 10))
            
            for _, Win in pairs(self.Windows) do
                -- Fade Pillar Bases
                Win.Drawings.Main.Transparency = Alpha * 0.9
                Win.Drawings.Outline.Transparency = Alpha * 0.5
                Win.Drawings.Header.Transparency = Alpha
                Win.Drawings.Accent.Transparency = Alpha
                
                -- Fade The BOLD Titles
                Win.Drawings.Title.Transparency = Alpha
                
                -- Fade Every Element Inside
                for _, Element in pairs(Win.Elements) do
                    for _, DrawObj in pairs(Element.Drawings) do
                        DrawObj.Transparency = Alpha
                    end
                    -- Special handling for open dropdowns
                    if Element.OptionDrawings then
                        for _, Opt in pairs(Element.OptionDrawings) do
                            Opt.Transparency = Alpha
                        end
                    end
                end
            end
            RS.RenderStepped:Wait()
        end
        
        -- Hard lock visibility after fade
        if not state then
            for _, Win in pairs(self.Windows) do Win:SetVisible(false) end
        end
    end)
end

-- [[ INPUT BUFFERING (Z-PASS) ]] --
-- This ensures that only the TOPMOST element gets clicked.
Luminaia.IsIntersecting = false

local function CheckIntersections()
    local MousePos = GetMousePos()
    local Found = false
    
    -- Check Windows from front to back
    for i = #Luminaia.Windows, 1, -1 do
        local Win = Luminaia.Windows[i]
        if Win.Visible and IsMouseOver(Win.Drawings.Header.Position, Win.Drawings.Header.Size) then
            Found = true
            break
        end
    end
    Luminaia.IsIntersecting = Found
end

-- Hook into the Part 1 Toggle Logic
Luminaia:Connect("OnToggle", function(state)
    Luminaia:AnimateToggle(state)
end)

-- [[ DYNAMIC TEXT CLAMPING ]] --
-- Prevents long names from bleeding out of the 95px pillars
function Luminaia:ClampText(textObj, maxWidth)
    local OriginalText = textObj.Text
    while textObj.TextBounds.X > (maxWidth - 10) and #textObj.Text > 3 do
        textObj.Text = string.sub(textObj.Text, 1, #textObj.Text - 1)
    end
    if textObj.Text ~= OriginalText then
        textObj.Text = textObj.Text .. ".."
    end
end

