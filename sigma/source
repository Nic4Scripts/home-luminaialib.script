--[[
    LUMINAIA UI FRAMEWORK v1.1
    Part 2: Window Constructor, Pillar Math & Dragging Logic
--]]

function Luminaia:CreateWindow(name)
    local Window = {
        Title = name,
        Elements = {},
        Visible = false, -- STARTS HIDDEN
        YOffset = 42,    -- Start drawing elements lower
        Dragging = false,
        DragOffset = Vector2.new(0, 0)
    }

    local Screen = workspace.CurrentCamera.ViewportSize
    local Index = #self.Windows
    
    -- [[ 12-PILLAR GRID MATH ]] --
    -- 6 Columns per Row | 110px spacing (Wider than before)
    local Col = Index % 6
    local Row = math.floor(Index / 6)
    local SpacingX = 110 
    local TotalWidth = (6 * 90) + (5 * 20)
    
    local StartX = (Screen.X / 2) - (TotalWidth / 2) + (Col * SpacingX)
    local StartY = (Screen.Y / 2) - (Row == 0 and 520 or -20)

    -- [[ THE 1000PX PILLAR BASE ]] --
    local MainFrame = self.Draw("Square", {
        Size = Vector2.new(95, 1000), -- Slightly wider (95px)
        Position = Vector2.new(StartX, StartY),
        Color = Color3.fromRGB(10, 10, 10),
        Filled = true,
        Visible = false,
        Transparency = 0.9,
        ZIndex = 10
    })

    local MainOutline = self.Draw("Square", {
        Size = MainFrame.Size,
        Position = MainFrame.Position,
        Color = Color3.fromRGB(35, 35, 35),
        Filled = false,
        Visible = false,
        Thickness = 1,
        Transparency = 0.5,
        ZIndex = 11
    })

    -- [[ THE HEADER (BOLD & SHIFTED) ]] --
    local Header = self.Draw("Square", {
        Size = Vector2.new(95, 35), -- Taller header for bold text
        Position = MainFrame.Position,
        Color = Color3.fromRGB(18, 18, 18),
        Filled = true,
        Visible = false,
        ZIndex = 12
    })

    local HeaderAccent = self.Draw("Square", {
        Size = Vector2.new(95, 2),
        Position = Header.Position + Vector2.new(0, 33),
        Color = self.Accent,
        Filled = true,
        Visible = false,
        ZIndex = 13
    })

    -- WIDER / BOLD / LOWERED TEXT
    local TitleText = self.Draw("Text", {
        Text = name:upper(),
        Size = 15, -- Bigger font
        Center = true,
        Position = Header.Position + Vector2.new(47, 10), -- Shifted DOWN (10px)
        Visible = false,
        Color = Color3.new(1, 1, 1),
        Outline = true,
        Font = 2, -- BOLD/MONOSPACE
        ZIndex = 14
    })

    Window.Drawings = {
        Main = MainFrame,
        Outline = MainOutline,
        Header = Header,
        Accent = HeaderAccent,
        Title = TitleText
    }

    -- [[ VISIBILITY TOGGLE ]] --
    function Window:SetVisible(state)
        self.Visible = state
        for _, draw in pairs(self.Drawings) do
            draw.Visible = state
        end
        -- Toggle all buttons/toggles inside
        for _, element in pairs(self.Elements) do
            for _, edraw in pairs(element.Drawings) do
                edraw.Visible = state
            end
        end
    end

    -- [[ SMOOTH DRAGGING LOGIC ]] --
    -- Allows you to move the 1000px pillars around the screen
    RS.RenderStepped:Connect(function()
        if Window.Dragging and Luminaia.Toggled then
            local MousePos = UIS:GetMouseLocation()
            local NewPos = MousePos - Window.DragOffset
            
            -- Move Main Pillar
            local Delta = NewPos - MainFrame.Position
            MainFrame.Position = NewPos
            MainOutline.Position = NewPos
            Header.Position = NewPos
            HeaderAccent.Position = Header.Position + Vector2.new(0, 33)
            TitleText.Position = Header.Position + Vector2.new(47, 10)

            -- Move all elements inside the pillar
            for _, element in pairs(Window.Elements) do
                for _, edraw in pairs(element.Drawings) do
                    edraw.Position = edraw.Position + Delta
                end
            end
        end
    end)

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and Window.Visible then
            local MousePos = UIS:GetMouseLocation()
            -- Check if clicking the Header
            if MousePos.X >= Header.Position.X and MousePos.X <= Header.Position.X + Header.Size.X then
                if MousePos.Y >= Header.Position.Y and MousePos.Y <= Header.Position.Y + Header.Size.Y then
                    Window.Dragging = true
                    Window.DragOffset = MousePos - Header.Position
                end
            end
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Window.Dragging = false
        end
    end)

    -- [[ REGISTER WINDOW ]] --
    table.insert(Luminaia.Windows, Window)
    return Window
end

