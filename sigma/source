local Luminaia = {
    Windows = {},
    Flags = {},
    Toggled = false, -- STARTS CLOSED (HIDDEN)
    User = "Prizmm",
    Accent = Color3.fromRGB(255, 100, 200), -- Blossom Pink Default
    Registry = {},
    Signals = {}
}

-- [[ SERVICES ]] --
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Mouse = game:GetService("Players").LocalPlayer:GetMouse()

-- [[ INTERNAL SIGNAL API ]] --
-- Replaces standard Luau events for 0-latency execution
function Luminaia:Connect(name, callback)
    self.Signals[name] = self.Signals[name] or {}
    table.insert(self.Signals[name], callback)
end

function Luminaia:Fire(name, ...)
    if self.Signals[name] then
        for _, cb in pairs(self.Signals[name]) do
            task.spawn(cb, ...)
        end
    end
end

-- [[ THEME CONTROLLER ]] --
-- Handles the "Pulsing" and "Glowing" effects globally
local Theme = {
    Main = Color3.fromRGB(12, 12, 12),
    Outline = Color3.fromRGB(45, 45, 45),
    Text = Color3.fromRGB(255, 255, 255),
    TextDark = Color3.fromRGB(160, 160, 160)
}

-- [[ DRAWING WRAPPER ]] --
-- High-performance object creation
local function Draw(type, props)
    local obj = Drawing.new(type)
    for i, v in pairs(props) do
        obj[i] = v
    end
    return obj
end
Luminaia.Draw = Draw -- Export for other parts

-- [[ BLUR CONTROLLER ]] --
