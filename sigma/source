-- [[ SCREEN RESIZE REFRESH ]] --
-- This ensures that if the user changes resolution, 
-- the 12 pillars stay perfectly centered in their 2x6 grid.
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    local Screen = workspace.CurrentCamera.ViewportSize
    local TotalWidth = (6 * 95) + (5 * 15)
    local StartXBase = (Screen.X / 2) - (TotalWidth / 2)
    
    for idx, win in pairs(Luminaia.Windows) do
        local col = (idx - 1) % 6
        local row = math.floor((idx - 1) / 6)
        local newX = StartXBase + (col * 110)
        local newY = (Screen.Y / 2) - (row == 0 and 520 or -20)
        
        -- Shift Pillar and Elements
        local oldPos = win.Drawings.Main.Position
        local diff = Vector2.new(newX, newY) - oldPos
        
        win.Drawings.Main.Position = Vector2.new(newX, newY)
        win.Drawings.Outline.Position = win.Drawings.Main.Position
        win.Drawings.Header.Position = win.Drawings.Main.Position
        win.Drawings.Accent.Position = win.Drawings.Header.Position + Vector2.new(0, 33)
        win.Drawings.Title.Position = win.Drawings.Header.Position + Vector2.new(47, 10)
        
        -- Update All Elements within the Pillar
        for _, element in pairs(win.Elements) do
            for _, drawing in pairs(element.Drawings) do
                drawing.Position = drawing.Position + diff
            end
        end
    end
end)

