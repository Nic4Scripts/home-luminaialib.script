-- [[ MASTER TOGGLE LOGIC ]] --
function Luminaia:ToggleUI()
    self.Toggled = not self.Toggled
    
    -- Blur Logic: Only on when UI is open
    MenuBlur.Enabled = self.Toggled
    local TargetBlur = self.Toggled and 22 or 0
    TS:Create(MenuBlur, TweenInfo.new(0.4, Enum.EasingStyle.Quart), {Size = TargetBlur}):Play()
    
    -- Fire visibility to all windows (Part 2 logic)
    self:Fire("OnToggle", self.Toggled)
    
    -- Mouse Unlock
    UIS.MouseIconEnabled = not self.Toggled
end

UIS.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.RightShift then
        Luminaia:ToggleUI()
    end
end)

