-- [[ COLOR PICKER COMPONENT ]] --
function Window:AddColorPicker(text, default, flag, callback)
    local Picker = {
        Color = default or Color3.fromRGB(255, 100, 200),
        Open = false,
        Drawings = {},
        PickerDrawings = {}
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 10

    -- Label
    local Label = Luminaia.Draw("Text", {
        Text = text,
        Size = 13,
        Color = Color3.fromRGB(180, 180, 180),
        Position = Vector2.new(XPos, YPos),
        Visible = false,
        Outline = true,
        ZIndex = 15
    })

    -- The "Preview" Box (BOLD & THICK)
    local Preview = Luminaia.Draw("Square", {
        Size = Vector2.new(18, 10),
        Position = Vector2.new(XPos + 62, YPos + 2),
        Color = Picker.Color,
        Filled = true,
        Visible = false,
        ZIndex = 16
    })

    local PreviewOutline = Luminaia.Draw("Square", {
        Size = Preview.Size,
        Position = Preview.Position,
        Color = Color3.new(1, 1, 1),
        Filled = false,
        Thickness = 1,
        Visible = false,
        ZIndex = 17
    })

    Picker.Drawings = {Label, Preview, PreviewOutline}
    Luminaia.Flags[flag] = Picker.Color

    -- [[ PICKER GRID LOGIC ]] --
    local function TogglePicker()
        Picker.Open = not Picker.Open
        
        -- Cleanup
        for _, d in pairs(Picker.PickerDrawings) do d:Remove() end
        Picker.PickerDrawings = {}

        if Picker.Open then
            -- Create a simplified 40x40 Hue Map
            local GridPos = Preview.Position + Vector2.new(25, 0)
            
            local GridBG = Luminaia.Draw("Square", {
                Size = Vector2.new(60, 60),
                Position = GridPos,
                Color = Color3.fromRGB(15, 15, 15),
                Filled = true,
                Visible = true,
                ZIndex = 100
            })
            table.insert(Picker.PickerDrawings, GridBG)

            -- Creating the Rainbow Strip
            for i = 0, 60 do
                local HueLine = Luminaia.Draw("Square", {
                    Size = Vector2.new(60, 1),
                    Position = GridPos + Vector2.new(0, i),
                    Color = Color3.fromHSV(i/60, 1, 1),
                    Filled = true,
                    Visible = true,
                    ZIndex = 101
                })
                table.insert(Picker.PickerDrawings, HueLine)
            end

            -- Click Logic for the Rainbow
            task.spawn(function()
                while Picker.Open and Luminaia.Toggled do
                    if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                        local m = GetMousePos()
                        if IsMouseOver(GridPos, Vector2.new(60, 60)) then
                            local Percent = math.clamp((m.Y - GridPos.Y) / 60, 0, 1)
                            local NewColor = Color3.fromHSV(Percent, 1, 1)
                            
                            Picker.Color = NewColor
                            Preview.Color = NewColor
                            Luminaia.Flags[flag] = NewColor
                            callback(NewColor)
                        end
                    end
                    RS.RenderStepped:Wait()
                end
            end)
        end
    end

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if IsMouseOver(Preview.Position, Preview.Size) then
                TogglePicker()
            end
        end
    end)

    self.YOffset = self.YOffset + 18
    table.insert(self.Elements, Picker)
    return Picker
end

