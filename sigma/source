-- [[ CONFIG SAVING ]] --
function Luminaia:SaveConfig(name)
    local Data = {}
    
    for flag, value in pairs(self.Flags) do
        -- Handle complex types for JSON compatibility
        if typeof(value) == "Color3" then
            Data[flag] = {R = value.r, G = value.g, B = value.b, Type = "Color3"}
        elseif typeof(value) == "EnumItem" then
            Data[flag] = {Name = value.Name, Type = "Enum"}
        else
            Data[flag] = value
        end
    end
    
    local JSON = HttpService:JSONEncode(Data)
    local Success, Error = pcall(function()
        writefile("Luminaia_Configs/" .. name .. ".json", JSON)
    end)
    
    if Success then
        self:Notify("CONFIG '" .. name:upper() .. "' SAVED")
    else
        self:Notify("SAVE FAILED: " .. tostring(Error))
    end
end

-- [[ CONFIG LOADING ]] --
function Luminaia:LoadConfig(name)
    local Path = "Luminaia_Configs/" .. name .. ".json"
    
    if not isfile(Path) then 
        self:Notify("CONFIG NOT FOUND") 
        return 
    end
    
    local Raw = readfile(Path)
    local Data = HttpService:JSONDecode(Raw)
    
    for flag, value in pairs(Data) do
        if type(value) == "table" and value.Type == "Color3" then
            self.Flags[flag] = Color3.new(value.R, value.G, value.B)
        elseif type(value) == "table" and value.Type == "Enum" then
            -- Logic to resolve Enum names back to KeyCodes
            self.Flags[flag] = Enum.KeyCode[value.Name]
        else
            self.Flags[flag] = value
        end
    end
    
    self:Notify("CONFIG '" .. name:upper() .. "' LOADED")
    -- Note: Phase 9 handles the visual "Refresh" of the UI elements
end

