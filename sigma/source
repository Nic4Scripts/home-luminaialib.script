-- [[ UTILS: MOUSE COLLISION ]] --
local function GetMousePos()
    return UIS:GetMouseLocation()
end

local function IsMouseOver(pos, size)
    local m = GetMousePos()
    return m.X >= pos.X and m.X <= pos.X + size.X and m.Y >= pos.Y and m.Y <= pos.Y + size.Y
end

-- [[ TOGGLE COMPONENT ]] --
function Window:AddToggle(text, flag, default, callback)
    local Toggle = {
        State = default or false,
        Drawings = {},
        Hovering = false
    }
    
    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X
    
    -- Main Label (Shifted slightly for padding)
    local Label = Luminaia.Draw("Text", {
        Text = text,
        Size = 13,
        Color = Color3.fromRGB(180, 180, 180),
        Position = Vector2.new(XPos + 10, YPos),
        Visible = false,
        Outline = true,
        ZIndex = 15
    })
    
    -- Status Marker (The [+] or [-] with Glow)
    local Indicator = Luminaia.Draw("Text", {
        Text = Toggle.State and "[+]" or "[-]",
        Size = 13,
        Color = Toggle.State and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 50, 50),
        Position = Vector2.new(XPos + 72, YPos),
        Visible = false,
        Outline = true,
        ZIndex = 16
    })

    Toggle.Drawings = {Label, Indicator}
    Luminaia.Flags[flag] = Toggle.State

    -- [[ INTERACTION LOOP ]] --
    RS.RenderStepped:Connect(function()
        if not Luminaia.Toggled or not self.Visible then return end
        
        local Hover = IsMouseOver(Vector2.new(XPos, YPos), Vector2.new(95, 16))
        if Hover ~= Toggle.Hovering then
            Toggle.Hovering = Hover
            TS:Create(Label, TweenInfo.new(0.2), {Color = Hover and Color3.new(1,1,1) or Color3.fromRGB(180,180,180)}):Play()
        end
    end)

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if IsMouseOver(Vector2.new(XPos, YPos), Vector2.new(95, 16)) then
                Toggle.State = not Toggle.State
                Indicator.Text = Toggle.State and "[+]" or "[-]"
                Indicator.Color = Toggle.State and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(255, 50, 50)
                
                Luminaia.Flags[flag] = Toggle.State
                callback(Toggle.State)
                
                -- Pulse Effect on Toggle
                Indicator.Size = 16
                task.wait(0.05)
                Indicator.Size = 13
            end
        end
    end)

    self.YOffset = self.YOffset + 18
    table.insert(self.Elements, Toggle)
    return Toggle
end

-- [[ BUTTON COMPONENT ]] --
function Window:AddButton(text, callback)
    local Button = {Drawings = {}, Pressing = false}
    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X
    
    local Frame = Luminaia.Draw("Square", {
        Size = Vector2.new(85, 18),
        Position = Vector2.new(XPos + 5, YPos),
        Color = Color3.fromRGB(25, 25, 25),
        Filled = true,
        Visible = false,
        ZIndex = 15
    })
    
    local Outline = Luminaia.Draw("Square", {
        Size = Frame.Size,
        Position = Frame.Position,
        Color = Color3.fromRGB(50, 50, 50),
        Filled = false,
        Visible = false,
        Thickness = 1,
        ZIndex = 16
    })

    local BtnText = Luminaia.Draw("Text", {
        Text = text,
        Size = 12,
        Center = true,
        Position = Frame.Position + Vector2.new(42, 2),
        Visible = false,
        Color = Color3.new(1, 1, 1),
        Outline = true,
        ZIndex = 17
    })

    Button.Drawings = {Frame, Outline, BtnText}

    -- [[ CLICK ANIMATION ]] --
    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if IsMouseOver(Frame.Position, Frame.Size) then
                -- Visual Feedback
                Frame.Position = Frame.Position + Vector2.new(0, 1)
                BtnText.Position = BtnText.Position + Vector2.new(0, 1)
                Frame.Color = Color3.fromRGB(40, 40, 40)
                
                callback()
                
                task.wait(0.1)
                Frame.Position = Frame.Position - Vector2.new(0, 1)
                BtnText.Position = BtnText.Position - Vector2.new(0, 1)
                Frame.Color = Color3.fromRGB(25, 25, 25)
            end
        end
    end)

    self.YOffset = self.YOffset + 24
    table.insert(self.Elements, Button)
    return Button
end

