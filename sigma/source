MenuBlur.Name = "LuminaiaBlur"
MenuBlur.Size = 0
MenuBlur.Enabled = false
MenuBlur.Parent = Lighting

-- [[ WATERMARK & HUD ]] --
local Watermark = Draw("Text", {
