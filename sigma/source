-- [[ SLIDER COMPONENT ]] --
function Window:AddSlider(text, min, max, default, flag, callback)
    local Slider = {
        Value = default or min,
        Min = min,
        Max = max,
        Dragging = false,
        Drawings = {}
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 10
    
    -- Main Title for Slider
    local Label = Luminaia.Draw("Text", {
        Text = text,
        Size = 12,
        Color = Color3.fromRGB(180, 180, 180),
        Position = Vector2.new(XPos, YPos),
        Visible = false,
        Outline = true,
        ZIndex = 15
    })

    -- Value Display (Shifted Right)
    local ValLabel = Luminaia.Draw("Text", {
        Text = tostring(Slider.Value),
        Size = 11,
        Color = Luminaia.Accent,
        Position = Vector2.new(XPos + 65, YPos + 1),
        Visible = false,
        Outline = true,
        ZIndex = 16
    })

    -- Background Bar
    local BarBG = Luminaia.Draw("Square", {
        Size = Vector2.new(75, 4),
        Position = Vector2.new(XPos, YPos + 16),
        Color = Color3.fromRGB(30, 30, 30),
        Filled = true,
        Visible = false,
        ZIndex = 15
    })

    -- Interactive Fill Bar
    local BarFill = Luminaia.Draw("Square", {
        Size = Vector2.new(((Slider.Value - min) / (max - min)) * 75, 4),
        Position = BarBG.Position,
        Color = Luminaia.Accent,
        Filled = true,
        Visible = false,
        ZIndex = 16
    })

    Slider.Drawings = {Label, ValLabel, BarBG, BarFill}

    -- [[ SLIDER MATH ]] --
    local function UpdateSlider()
        local MouseLoc = GetMousePos()
        local Percent = math.clamp((MouseLoc.X - BarBG.Position.X) / BarBG.Size.X, 0, 1)
        local Value = math.floor(min + (max - min) * Percent)
        
        Slider.Value = Value
        BarFill.Size = Vector2.new(Percent * 75, 4)
        ValLabel.Text = tostring(Value)
        
        Luminaia.Flags[flag] = Value
        callback(Value)
    end

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if IsMouseOver(BarBG.Position - Vector2.new(0, 5), BarBG.Size + Vector2.new(0, 10)) then
                Slider.Dragging = true
                -- Visual Feedback: Make value label pop
                ValLabel.Size = 14
                UpdateSlider()
            end
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Slider.Dragging = false
            ValLabel.Size = 11 -- Return to normal
        end
    end)

    RS.RenderStepped:Connect(function()
        if Slider.Dragging and Luminaia.Toggled then
            UpdateSlider()
        end
    end)

    self.YOffset = self.YOffset + 32
    table.insert(self.Elements, Slider)
    return Slider
end

-- [[ KEYBIND COMPONENT ]] --
function Window:AddKeybind(text, default, flag, callback)
    local Bind = {
        Key = default or Enum.KeyCode.F,
        Binding = false,
        Drawings = {}
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 10

    local Label = Luminaia.Draw("Text", {
        Text = text,
        Size = 13,
        Color = Color3.fromRGB(180, 180, 180),
        Position = Vector2.new(XPos, YPos),
        Visible = false,
        Outline = true,
        ZIndex = 15
    })

    -- The Key Indicator (e.g. [MB2])
    local BindText = Luminaia.Draw("Text", {
        Text = "[" .. Bind.Key.Name:upper() .. "]",
        Size = 12,
        Color = Luminaia.Accent,
        Position = Vector2.new(XPos + 52, YPos),
        Visible = false,
        Outline = true,
        ZIndex = 16
    })

    Bind.Drawings = {Label, BindText}
    Luminaia.Flags[flag] = Bind.Key

    -- [[ KEY LISTENER LOOP ]] --
    UIS.InputBegan:Connect(function(input)
        if Bind.Binding then
            if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType == Enum.UserInputType.MouseButton2 then
                local NewKey = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or Enum.KeyCode.MouseButton2
                Bind.Key = NewKey
                BindText.Text = "[" .. NewKey.Name:upper() .. "]"
                Bind.Binding = false
                BindText.Color = Luminaia.Accent
                Luminaia.Flags[flag] = NewKey
            end
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if IsMouseOver(Vector2.new(XPos, YPos), Vector2.new(85, 15)) then
                Bind.Binding = true
                BindText.Text = "[...]"
                BindText.Color = Color3.new(1, 1, 0) -- Flashing Yellow
            end
        elseif input.KeyCode == Bind.Key and not Bind.Binding then
            callback() -- Trigger the cheat action
        end
    end)

    self.YOffset = self.YOffset + 18
    table.insert(self.Elements, Bind)
    return Bind
end

