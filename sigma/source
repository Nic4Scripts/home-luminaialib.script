-- [[ DROPDOWN COMPONENT ]] --
function Window:AddDropdown(text, list, default, flag, callback)
    local Dropdown = {
        List = list,
        Selected = default or list[1],
        Open = false,
        OptionDrawings = {},
        Drawings = {}
    }

    local YPos = self.Drawings.Main.Position.Y + self.YOffset
    local XPos = self.Drawings.Main.Position.X + 10

    -- Label for the Dropdown
    local Label = Luminaia.Draw("Text", {
        Text = text,
        Size = 12,
        Color = Color3.fromRGB(180, 180, 180),
        Position = Vector2.new(XPos, YPos),
        Visible = false,
        Outline = true,
        ZIndex = 15
    })

    -- The Interaction Box
    local Box = Luminaia.Draw("Square", {
        Size = Vector2.new(75, 16),
        Position = Vector2.new(XPos, YPos + 15),
        Color = Color3.fromRGB(20, 20, 20),
        Filled = true,
        Visible = false,
        ZIndex = 15
    })

    local BoxOutline = Luminaia.Draw("Square", {
        Size = Box.Size,
        Position = Box.Position,
        Color = Color3.fromRGB(45, 45, 45),
        Filled = false,
        Visible = false,
        ZIndex = 16
    })

    -- Selected Text with Arrow [v]
    local SelectedTxt = Luminaia.Draw("Text", {
        Text = Dropdown.Selected .. " [v]",
        Size = 11,
        Color = Luminaia.Accent,
        Position = Box.Position + Vector2.new(5, 2),
        Visible = false,
        Outline = true,
        ZIndex = 17
    })

    Dropdown.Drawings = {Label, Box, BoxOutline, SelectedTxt}
    Luminaia.Flags[flag] = Dropdown.Selected

    -- [[ OPEN/CLOSE LOGIC ]] --
    local function ToggleDropdown()
        Dropdown.Open = not Dropdown.Open
        SelectedTxt.Text = Dropdown.Open and Dropdown.Selected .. " [^]" or Dropdown.Selected .. " [v]"
        
        -- Cleanup old options if they exist
        for _, opt in pairs(Dropdown.OptionDrawings) do opt:Remove() end
        Dropdown.OptionDrawings = {}

        if Dropdown.Open then
            for i, val in pairs(Dropdown.List) do
                local OptBox = Luminaia.Draw("Square", {
                    Size = Vector2.new(75, 16),
                    Position = Box.Position + Vector2.new(0, i * 16),
                    Color = (val == Dropdown.Selected) and Color3.fromRGB(30, 30, 30) or Color3.fromRGB(15, 15, 15),
                    Filled = true,
                    Visible = true,
                    ZIndex = 50 -- Bring to front
                })
                
                local OptTxt = Luminaia.Draw("Text", {
                    Text = tostring(val),
                    Size = 11,
                    Color = (val == Dropdown.Selected) and Luminaia.Accent or Color3.new(1,1,1),
                    Position = OptBox.Position + Vector2.new(5, 2),
                    Visible = true,
                    Outline = true,
                    ZIndex = 51
                })

                table.insert(Dropdown.OptionDrawings, OptBox)
                table.insert(Dropdown.OptionDrawings, OptTxt)

                -- CLICKING AN OPTION
                task.spawn(function()
                    local connection
                    connection = UIS.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 and Dropdown.Open then
                            if IsMouseOver(OptBox.Position, OptBox.Size) then
                                Dropdown.Selected = val
                                SelectedTxt.Text = val .. " [v]"
                                Luminaia.Flags[flag] = val
                                callback(val)
                                ToggleDropdown() -- Close after select
                                connection:Disconnect()
                            end
                        end
                    end)
                end)
            end
        end
    end

    UIS.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and Luminaia.Toggled and self.Visible then
            if IsMouseOver(Box.Position, Box.Size) then
                ToggleDropdown()
            end
        end
    end)

    self.YOffset = self.YOffset + 38
    table.insert(self.Elements, Dropdown)
    return Dropdown
end

